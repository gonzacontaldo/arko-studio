# Copiá este archivo a .env.local y completá con los valores de tu proyecto Supabase.
# Supabase → Project Settings → API
#   Project URL        → VITE_SUPABASE_URL
#   anon public key    → VITE_SUPABASE_ANON_KEY  (es pública, va en el frontend)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Reservas: estas variables son SOLO del servidor. No usar prefijo VITE_.
# Estado inicial seguro: pruebas, formulario automático desactivado en Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
COMMERCIAL_MODE=test
COMMERCIAL_SITE_URL=https://arkostudio.com.ar
QUOTE_LINK_SECRET=
COMMERCIAL_JOB_SECRET=
COMMERCIAL_TEST_EMAIL=
# Cuenta Zoho: región com/eu/in/com.au/jp/ca. OAuth con ZohoMail.messages.CREATE.
ZOHO_REGION=com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNT_ID=
ZOHO_FROM_ADDRESS=gonzalo@arkostudio.com.ar
# Secreto compartido para registrar/verificar el webhook entrante de Zoho.
ZOHO_INBOUND_SECRET=
# Credenciales de prueba de Mercado Pago al principio.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_COLLECTOR_ID=

# manual: pause follow-up from admin after an email reply; webhook: Zoho integration
COMMERCIAL_REPLY_MODE=manual
